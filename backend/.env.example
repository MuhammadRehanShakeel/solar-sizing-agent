# Copy this file to .env and fill it in. .env is never uploaded to GitHub.

# --- SQL Server (SolarSaathi gets its own database) ---
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=SolarSaathi
DB_AUTH=windows
# Only for DB_AUTH=sql:
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

# --- Free AI keys (paste them here yourself; never share them) ---
# Groq: https://console.groq.com/keys      (chat + voice)
GROQ_API_KEY=
# Gemini: https://aistudio.google.com/apikey  (bill photos + backup chat)
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.8-flash
WHISPER_MODEL=whisper-large-v3-turbo

# --- Security ---
JWT_SECRET=
JWT_EXPIRE_MINUTES=240

# --- Server ---
API_HOST=127.0.0.1
API_PORT=5002
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,capacitor://localhost,http://localhost

# --- Quotation ---
INSTALLER_NAME=SolarSaathi Demo Installers
INSTALLER_PHONE=0300-0000000
PUBLIC_BASE_URL=http://localhost:5175
